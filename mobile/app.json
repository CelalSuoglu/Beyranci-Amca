{
  "expo": {
    "name": "Beyrancı Amca",
    "slug": "beyranci-amca",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0a09",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beyranciamca.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.beyranciamca.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0a09"
      },
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "scheme": "beyranciamca",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#d4af37",
          "sounds": [
            "./assets/alarm.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
